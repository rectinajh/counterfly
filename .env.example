# Creditcoin CC3 testnet
CC3_TESTNET_RPC=https://rpc.cc3-testnet.creditcoin.network
PROVER_ENDPOINT=https://prover.cc3-testnet.creditcoin.network
CHAIN_KEY=1

# Sepolia source chain (public endpoint; replace with your own provider if desired)
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Worker / deployer key. Do not commit a real key.
PRIVATE_KEY=

# Worker address used for ASC authorization and EIP-712 signatures
WORKER_ADDRESS=
RELAYER_ADDRESS=

# Filled after deployment
COUNTERFLY_ASC_ADDRESS=
RWA_ACTION_ADDRESS=

# Worker API (Vercel proxy → full Attest + commit + relay)
COUNTERFLY_API_ORIGIN=http://127.0.0.1:8787

# Attestcoin: set true only for offline CI. Use false for judge demos.
SKIP_ATTEST=false

# When true, demo brain also uses the canonical verified Sepolia payment tx.
ATTEST_CANONICAL_TX=false

# Paste after recording docs/DEMO_VIDEO.md
DEMO_VIDEO_URL=
